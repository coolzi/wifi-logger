/* Recording */
"Записать замеры" = "Wi-Fi পরিমাপ রেকর্ড করুন";
"Нажмите **«Начать запись»** или **⌘R**. Приложение делает замер Wi-Fi примерно каждые 250 мс." = "**রেকর্ডিং শুরু করুন** ক্লিক করুন বা **⌘R** চাপুন। অ্যাপটি প্রায় প্রতি ২৫০ মিলিসেকেন্ডে একটি Wi-Fi পরিমাপ নেয়।";
"**«Приостановить запись»** сохраняет накопленные замеры и снимки в окне. **«Продолжить запись»** добавляет данные к той же сессии." = "**রেকর্ডিং সাময়িক থামান** বেছে নিলে এ পর্যন্ত সংগৃহীত পরিমাপ ও স্ন্যাপশট উইন্ডোতে থাকে। **রেকর্ডিং চালিয়ে যান** বেছে নিলে একই সেশনে নতুন ডেটা যোগ হয়।";

/* Chart navigation */
"Найти момент на графике" = "গ্রাফে একটি সময় খুঁজুন";
"В меню **«Диапазон»** выберите от 30 с до 15 мин. На вкладке **«Замеры Wi-Fi»** стрелки и ползунок **«Окно графика»** под графиком сдвигают видимый период. Они появляются, когда в записи несколько замеров и часть из них находится за пределами видимого диапазона." = "**সময়সীমা** মেনুতে ৩০ সেকেন্ড থেকে ১৫ মিনিটের মধ্যে একটি সময়কাল বেছে নিন। **Wi-Fi পরিমাপ** ট্যাবে গ্রাফের নিচের তীরচিহ্ন ও **গ্রাফের সময়সীমা** স্লাইডার দিয়ে দৃশ্যমান অংশ সরান। একাধিক পরিমাপ থাকলে এবং তার কিছু দৃশ্যমান সময়সীমার বাইরে থাকলে এই নিয়ন্ত্রণগুলো দেখা যায়।";
"Чтобы выбрать момент, щёлкните по графику или по строке в **«Событиях»**. **«Выбранный момент»** вверху окна и диапазон сохраняются при смене вкладки. Если ближайший замер или снимок получен в другое время, оно указано рядом с его данными. **«К последним данным»** вернёт обе вкладки к концу записи." = "সময় বেছে নিতে গ্রাফে বা **ইভেন্ট তালিকা** অংশের একটি সারিতে ক্লিক করুন। ট্যাব বদলালেও উইন্ডোর ওপরে দেখানো **নির্বাচিত সময়** ও সময়সীমা বজায় থাকে। নিকটতম পরিমাপ বা স্ন্যাপশটটি অন্য সময়ে নেওয়া হয়ে থাকলে ডেটার পাশে সেই সময় দেখানো হয়। **সর্বশেষ ডেটায় ফিরুন** বেছে নিলে উভয় ট্যাব রেকর্ডিংয়ের শেষে ফিরে যায়।";
"С клавиатуры" = "কীবোর্ড ব্যবহার করুন";
"Для выбора с клавиатуры нажимайте **Tab**, пока фокус не окажется на графике. **←** и **→** перебирают замеры и снимки в видимом диапазоне. На графике NSS они переходят между доступными показаниями. **Enter** выбирает показанный замер, снимок или показание." = "ফোকাস গ্রাফে না আসা পর্যন্ত **Tab** চাপুন। দৃশ্যমান সময়সীমার পরিমাপ বা স্ন্যাপশটগুলোর মধ্যে চলাচল করতে **←** বা **→** চাপুন। NSS গ্রাফে তীর কী দিয়ে পাওয়া মানগুলোর মধ্যে চলাচল করা যায়। দেখানো পরিমাপ, স্ন্যাপশট বা মান বেছে নিতে **Enter** চাপুন।";

/* Signal and outages */
"Понять сигнал и обрывы" = "সিগন্যাল ও সংযোগ বিচ্ছিন্নতা বুঝুন";
"В разделе **«Графики»** включите нужные показатели. RSSI и шум читаются по левой шкале. Справа можно показать RTT, SNR или PHY-скорость. Курсор и диапазон времени общие." = "**গ্রাফ** বিভাগে যে সূচকগুলো দেখতে চান সেগুলো চালু করুন। RSSI ও নয়েজ বাম স্কেলে দেখা যায়, আর ডান স্কেলে RTT, SNR বা PHY গতি দেখা যায়। গ্রাফে একই কার্সর ও সময়সীমা ব্যবহৃত হয়।";
"RSSI — уровень сигнала. Значение −55 дБм означает более сильный сигнал, чем −70 дБм. Чем выше SNR, тем лучше сигнал различим на фоне шума. Пороги качества доступны под графиком в разделе **«Как читать цвета»**." = "RSSI প্রাপ্ত সিগন্যালের শক্তি মাপে। −55 dBm মানে −70 dBm-এর চেয়ে শক্তিশালী সিগন্যাল। SNR যত বেশি, শব্দ থেকে সিগন্যাল তত সহজে আলাদা করা যায়। গ্রাফের নিচে **রং বোঝা** বিভাগে মানের সীমাগুলো পাওয়া যায়।";
"В **«Событиях»** видны обрывы и восстановления связи, изменения номера, диапазона или ширины канала. Приложение отмечает смену точки доступа, когда у соседних замеров подключения совпадает SSID и меняется BSSID." = "**ইভেন্ট তালিকা** অংশে সংযোগ বিচ্ছিন্ন হওয়া, ফিরে আসা এবং চ্যানেল নম্বর, ব্যান্ড বা প্রস্থের পরিবর্তন দেখা যায়। পরপর দুটি সংযুক্ত অবস্থার পরিমাপে SSID একই থাকলেও BSSID বদলালে অ্যাপটি অ্যাক্সেস পয়েন্ট বদলের ইভেন্ট রেকর্ড করে।";

/* Modulation */
"Сравнить модуляцию и скорость" = "মডুলেশন ও প্রেরণের হার তুলনা করুন";
"Откройте вкладку **«Снимки модуляции»** и выберите точку на графике MCS, скорости передачи или NSS. Снимки собираются отдельными запросами. macOS может сообщить MCS, режим Wi-Fi, канал и скорость передачи по соединению Wi-Fi." = "**মডুলেশন স্ন্যাপশট** খুলে MCS, প্রেরণের হার বা NSS-এর গ্রাফে একটি পয়েন্ট বেছে নিন। প্রতিটি স্ন্যাপশট আলাদা অনুরোধ থেকে আসে। macOS থেকে MCS, Wi-Fi মোড, চ্যানেল ও Wi-Fi সংযোগের প্রেরণের হার পাওয়া যেতে পারে।";
"Для известных сочетаний MCS и режима Wi-Fi приложение показывает модуляцию и кодовую скорость. Для 1024-QAM один символ на поднесущей кодирует 10 бит в одном пространственном потоке. При тех же условиях больше бит на символ позволяют передавать данные быстрее. Цвет точки MCS показывает тип модуляции. Цвета можно сверить в **«Как читать цвета MCS»** под графиками. Полоса **«Запрос macOS»** показывает интервал от начала запроса до ответа." = "MCS ও Wi-Fi মোডের সমন্বয় পরিচিত হলে অ্যাপটি মডুলেশন ও কোডিংয়ের হার দেখায়। 1024-QAM-এ একটি স্থানিক স্ট্রিমে একটি সাবক্যারিয়ারের প্রতি সিম্বলে ১০ বিট এনকোড হয়। একই পরিস্থিতিতে প্রতি সিম্বলে বেশি বিট থাকলে বেশি গতিতে ডেটা পাঠানো যায়। প্রতিটি MCS পয়েন্টের রং মডুলেশনের ধরন বোঝায়। গ্রাফগুলোর নিচে **MCS-এর রঙের অর্থ** দেখুন। **macOS-এ অনুরোধ** বারটি অনুরোধের শুরু থেকে উত্তর পর্যন্ত সময় দেখায়।";
"Когда накопится хотя бы два снимка, переключайтесь между ними стрелками или ползунком **«Выбор снимка»**. VoiceOver озвучивает у ползунка время ответа по снимку." = "অন্তত দুটি স্ন্যাপশট পাওয়া গেলে তীরচিহ্ন বা **স্ন্যাপশট নির্বাচন** স্লাইডার দিয়ে এক স্ন্যাপশট থেকে অন্যটিতে যান। স্লাইডারটির জন্য VoiceOver স্ন্যাপশটের উত্তরের সময় পড়ে শোনায়।";
"**NSS (macOS)** — число пространственных потоков. Под числом указано время отдельного ответа macOS. Если число потоков недоступно или приложение обнаружило смену точки доступа, в карточке будет прочерк, а на графике — пропуск." = "**NSS (macOS)** হলো স্থানিক স্ট্রিমের সংখ্যা। সংখ্যাটির নিচে দেখানো সময়ে macOS আলাদা একটি উত্তরে এই মান দিয়েছে। মান পাওয়া না গেলে বা অ্যাপটি অ্যাক্সেস পয়েন্টের পরিবর্তন শনাক্ত করলে কার্ডে একটি ড্যাশ ও গ্রাফে একটি ফাঁক দেখা যায়।";

/* Export */
"Сохранить запись" = "রেকর্ডিং সংরক্ষণ করুন";
"В окне записи откройте **«Сохранить CSV»**. Пункты **«Замеры Wi-Fi…»** и **«Снимки модуляции…»** сохраняют данные в отдельные файлы. Экспорт работает во время записи. В файл попадут данные, накопленные к моменту подтверждения сохранения." = "রেকর্ডিং উইন্ডোতে **CSV সংরক্ষণ** খুলুন। **Wi-Fi পরিমাপ…** ও **মডুলেশন স্ন্যাপশট…** আলাদা ফাইলে ডেটা সংরক্ষণ করে। রেকর্ডিং চলাকালেও এক্সপোর্ট করা যায়। সংরক্ষণ নিশ্চিত করার মুহূর্ত পর্যন্ত সংগৃহীত ডেটা সংশ্লিষ্ট ফাইলে থাকে।";
"Чтобы сохранить замеры Wi-Fi и снимки модуляции перед закрытием окна или сбросом через **«Новая запись…»**, приостановите запись и сохраните каждый доступный CSV. Пауза фиксирует конец записи для обоих файлов. Время последнего замера и последнего снимка может различаться." = "উইন্ডো বন্ধ করার বা **নতুন রেকর্ডিং…** বেছে নেওয়ার আগে Wi-Fi পরিমাপ ও মডুলেশন স্ন্যাপশট রাখতে **রেকর্ডিং সাময়িক থামান** ক্লিক করে উপলভ্য প্রতিটি CSV সংরক্ষণ করুন। বিরতি দিলে দুটি ফাইলের জন্যই রেকর্ডিংয়ের শেষ সময় স্থির হয়। শেষ পরিমাপ ও শেষ স্ন্যাপশটের সময় আলাদা হতে পারে।";
"Замеры шлюза доступны до сброса записи или закрытия окна." = "রেকর্ডিং রিসেট করা বা উইন্ডো বন্ধ করা পর্যন্ত গেটওয়ের পরিমাপ পাওয়া যায়।";

/* Network names and location permission */
"Показать имя сети и BSSID" = "নেটওয়ার্কের নাম ও BSSID দেখুন";
"При подключении к Wi-Fi имя сети и адрес точки доступа (BSSID) могут быть скрыты. На вкладке **«Замеры Wi-Fi»** нажмите **«Разрешить»**, если приложение предлагает доступ. После отказа откройте **«Системные настройки» → «Конфиденциальность и безопасность» → «Службы геолокации»** и разрешите доступ Wi-Fi Logger. Если запись на паузе, продолжите её, чтобы обновить поля." = "Wi-Fi সংযুক্ত থাকলেও macOS নেটওয়ার্কের নাম ও অ্যাক্সেস পয়েন্টের ঠিকানা (BSSID) লুকিয়ে রাখতে পারে। অ্যাপটি অনুমতি চাওয়ার বিকল্প দেখালে **Wi-Fi পরিমাপ** ট্যাবে **অনুমতি দিন** ক্লিক করুন। আগে অনুমতি না দিয়ে থাকলে **সিস্টেম সেটিংস → গোপনীয়তা ও নিরাপত্তা → অবস্থান পরিষেবা** (System Settings → Privacy & Security → Location Services) খুলে Wi-Fi Logger-কে অনুমতি দিন। রেকর্ডিং বিরতিতে থাকলে ঘরগুলো আপডেট করতে **রেকর্ডিং চালিয়ে যান** ক্লিক করুন।";

/* Access point directory */
"Загрузить имена точек доступа" = "অ্যাক্সেস পয়েন্টের নাম ইমপোর্ট করুন";
"Подготовьте CSV" = "CSV তৈরি করুন";
"bssid,ap_name\n02:11:22:33:44:55,Кабинет 301\n0211-2233-4466,\"Холл, зона \"\"А\"\" у входа\"" = "bssid,ap_name\n02:11:22:33:44:55,Room 301\n0211-2233-4466,\"Lobby, zone \"\"A\"\"\"";
"Сохраните файл в кодировке UTF-8. В первой строке укажите `bssid,ap_name`. Добавьте хотя бы одну запись. В каждой записи укажите BSSID (MAC-адрес точки доступа) и её непустое имя через запятую. Имя должно быть на одной строке, без табуляции и других управляющих символов." = "ফাইলটি UTF-8 এনকোডিংয়ে সংরক্ষণ করুন। প্রথম লাইনে `bssid,ap_name` লিখে অন্তত একটি এন্ট্রি যোগ করুন। কমা দিয়ে আলাদা করে BSSID (অ্যাক্সেস পয়েন্টের MAC ঠিকানা) ও একটি নাম লিখুন। নাম খালি রাখবেন না। প্রতিটি নাম এক লাইনে রাখুন এবং ট্যাব বা অন্য কোনো নিয়ন্ত্রণ অক্ষর ব্যবহার করবেন না।";
"BSSID можно записать с двоеточиями или в формате Huawei с дефисами. Регистр букв в адресе не важен. Одно имя можно указать для нескольких BSSID. Если один адрес встречается несколько раз, у него должно быть одно и то же имя." = "BSSID লিখতে কোলন ব্যবহার করুন বা হাইফেনসহ Huawei বিন্যাস ব্যবহার করুন। ঠিকানায় বড় বা ছোট হাতের অক্ষরে কোনো পার্থক্য হয় না। একাধিক BSSID-এর নাম একই হতে পারে। একই ঠিকানা একাধিকবার থাকলে প্রতিবার একই নাম ব্যবহার করুন।";
"Если в имени есть запятая или двойная кавычка, заключите имя в двойные кавычки. Каждую двойную кавычку внутри имени запишите дважды." = "নামে কমা বা দ্বৈত উদ্ধৃতিচিহ্ন থাকলে পুরো নাম দ্বৈত উদ্ধৃতিচিহ্নে ঘিরুন। নামের ভেতরের প্রতিটি দ্বৈত উদ্ধৃতিচিহ্ন পরপর দুবার লিখুন।";
"Загрузите справочник" = "তালিকা লোড করুন";
"Выберите **«Файл» → «Импорт имён точек доступа…»** и откройте CSV. Сверьте число уникальных имён и адресов BSSID. При первой загрузке нажмите **«Загрузить»**. Если приложение указало номер строки с ошибкой, исправьте её и откройте файл снова." = "macOS-এর ফাইল মেনু থেকে **অ্যাক্সেস পয়েন্টের নাম ইমপোর্ট…** বেছে নিয়ে CSV খুলুন। মেনুর নাম সিস্টেমের ভাষায় দেখানো হয়। স্বতন্ত্র নাম ও BSSID-এর সংখ্যা মিলিয়ে দেখুন। প্রথমবার ইমপোর্ট করলে **লোড করুন** ক্লিক করুন। অ্যাপটি ভুলের লাইন নম্বর দেখালে সেই লাইন ঠিক করে ফাইলটি আবার খুলুন।";
"При повторном импорте диалог покажет, сколько BSSID добавится, потеряет имя или сменит его. Кнопка **«Заменить»** применяет новый список целиком. Чтобы сохранить нужные имена, перенесите их в новый CSV вместе с BSSID." = "আবার ইমপোর্ট করলে ডায়ালগে দেখা যাবে, কতটি BSSID যোগ হবে, কতটির নাম বাদ যাবে আর কতটির নাম বদলাবে। **প্রতিস্থাপন** ক্লিক করলে নতুন তালিকাটি পুরোপুরি প্রয়োগ হবে। আগের কোনো নাম রাখতে চাইলে নতুন CSV-তে সংশ্লিষ্ট BSSID-সহ সেটি রাখুন।";
"Имя из справочника видно под BSSID в замере и рядом с соответствующим адресом в событии смены точки. Справочник доступен после перезапуска." = "তালিকার নামটি পরিমাপে সংশ্লিষ্ট BSSID-এর নিচে এবং অ্যাক্সেস পয়েন্ট বদলের ইভেন্টে সংশ্লিষ্ট ঠিকানার পাশে দেখা যায়। অ্যাপ আবার চালু করলেও তালিকাটি পাওয়া যায়।";

